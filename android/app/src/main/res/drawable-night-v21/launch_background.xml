<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode splash for API 21+ - matches Flutter splash exactly -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background to match Flutter -->
    <item android:drawable="@color/splash" />

    <!-- Icon centered, sized to match Flutter (200dp) -->
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launcher_icon" />
    </item>
</layer-list>
